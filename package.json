    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.1.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "phaser-box2d": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "z-proximity-engine": "^2.5.7"
  },
  "devDependencies": {
