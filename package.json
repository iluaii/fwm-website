    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "prebuild": "node -e \"if (require('fs').existsSync('.git')) { require('child_process').execSync('git submodule update --init --remote && cd fwm-repo && git sparse-checkout init --no-cone && git sparse-checkout set \\\"docs/*\\\"', {stdio: 'inherit'}); } else { console.log('Skipping git submodule (running in Vercel build environment)'); }\"",
    "preview": "astro preview",
    "astro": "astro"
  },
