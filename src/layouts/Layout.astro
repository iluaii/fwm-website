---
import { ClientRouter } from 'astro:transitions';
import { Navbar } from '../components/Navbar';
import { SmoothScroll } from '../components/SmoothScroll';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showPreloader?: boolean;
}

const {
  title = "fwm — Physics Window Manager (Wayland)",
  description = "A Wayland compositor written in C where windows behave as physical objects with mass, momentum, inertia, and velocity.",
  showPreloader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@1,400..900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@1,400..900&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@1,400..900&display=swap"
      />
    </noscript>
  </head>
  
  <body class={`bg-slate-950 text-slate-100 antialiased selection:bg-amber-500 selection:text-slate-950 overflow-x-hidden ${showPreloader ? 'is-preloading' : ''}`}>
    
    {showPreloader && (
      <>
        <div id="app-preloader-overlay" class="fixed inset-0 z-50 bg-slate-950 pointer-events-none"></div>

        <div id="app-preloader-content" class="fixed inset-0 z-[51] pointer-events-none flex flex-col items-center justify-center select-none">
          <div id="app-preloader-logo-wrapper" class="relative w-64 h-36 flex items-center justify-center filter drop-shadow-[0_0_20px_rgba(208,168,44,0.35)] pointer-events-none will-change-transform">
            <svg id="app-preloader-svg" xmlns="http://www.w3.org/2000/svg" viewBox="-4 -4 248 140" class="w-full h-full overflow-visible pointer-events-none">
              <g fill="none" stroke="#d0a82c" stroke-width="6" stroke-linejoin="miter" stroke-linecap="butt">
                <polygon class="badge-polygon opacity-60" points="66,0 174,0 240,66 174,132 66,132 0,66" />
                <polyline class="bracket-line opacity-80" points="10,26 -16,66 10,106" />
                <polyline class="bracket-line opacity-80" points="230,26 256,66 230,106" />
                <g transform="translate(64,13)">
                  <polyline class="mono-line" points="6,96 6,10 76,10" />
                  <polyline class="mono-line" points="6,46 34,46" />
                  <polyline class="mono-line" points="34,46 46,96 54,62 64,96 76,10" />
                  <polyline class="mono-line" points="76,10 90,54 104,14 104,96" />
                </g>
              </g>
            </svg>
          </div>

          <div id="app-preloader-progress-container" class="mt-6 flex flex-col items-center w-64 sm:w-72 pointer-events-none">
            <div class="flex items-center space-x-3.5 w-full">
              <div class="flex-1 h-1.5 bg-slate-900 border border-amber-500/30 rounded-full overflow-hidden p-[1px] relative">
                <div id="app-preloader-bar" class="h-full bg-amber-400 rounded-full w-0 shadow-[0_0_12px_#d0a82c]"></div>
              </div>
              <span id="app-preloader-percent" class="font-mono text-xs text-amber-400 font-bold tracking-wider min-w-[38px] text-right">0%</span>
            </div>
            {/* LIVE LOADING LOGS */}
            <div id="app-preloader-log" class="mt-3 font-mono text-[9px] text-slate-500 uppercase tracking-widest h-4">
              [sys] Initializing session...
            </div>
          </div>
        </div>

        <script>
          import gsap from 'gsap';

          const runPreloaderAnimation = () => {
            // Bypass if already loaded in this session
            if (sessionStorage.getItem('fwm_preloaded') === 'true') {
              document.body.classList.remove('is-preloading');
              const overlay = document.getElementById('app-preloader-overlay');
              const content = document.getElementById('app-preloader-content');
              if (overlay) overlay.style.display = 'none';
              if (content) content.style.display = 'none';
              return;
            }

            const startTime = Date.now();
            let targetProgress = 5; 
            let currentProgress = 0;
            let isCompleted = false;

            const logEl = document.getElementById('app-preloader-log');
            const updateLog = (msg: string) => {
              if (logEl && logEl.innerText !== msg) logEl.innerText = msg;
            };

            let isBrowserLoaded = document.readyState === 'complete';
            if (!isBrowserLoaded) {
              updateLog('[sys] Resolving DOM tree...');
              document.addEventListener('readystatechange', () => {
                if (document.readyState === 'interactive') updateLog('[sys] Mapping layout buffers...');
                if (document.readyState === 'complete') {
                  isBrowserLoaded = true;
                  updateLog('[ok] Layout environment ready.');
                }
              });
              window.addEventListener('load', () => { isBrowserLoaded = true; });
            } else {
              updateLog('[ok] Environment cached.');
            }

            if (document.fonts) {
              document.fonts.ready.then(() => { 
                targetProgress = Math.max(targetProgress, 60); 
                if (!isBrowserLoaded) updateLog('[sys] Typography loaded, awaiting window...');
              });
            }

            const svg = document.getElementById('app-preloader-svg');
            const paths = svg?.querySelectorAll('polyline, polygon') || [];
            const pathData: { el: SVGGeometryElement; length: number }[] = [];

            paths.forEach((path) => {
              const p = path as SVGGeometryElement;
              const length = p.getTotalLength ? p.getTotalLength() : 400;
              p.style.strokeDasharray = `${length}`;
              p.style.strokeDashoffset = `${length}`;
              pathData.push({ el: p, length });
            });

            const performDocking = () => {
              sessionStorage.setItem('fwm_preloaded', 'true');
              updateLog('[sys] Handshake initialized...');

              const sourceSvg = document.getElementById('app-preloader-svg');
              const targetSlot = document.getElementById('navbar-logo-slot');
              const navContainer = document.getElementById('navbar-container');
              const targetSvg = document.getElementById('navbar-logo-svg');
              const overlay = document.getElementById('app-preloader-overlay');

              // 1. Fade out UI components
              gsap.to('#app-preloader-progress-container', { opacity: 0, y: 10, duration: 0.3 });
              if (overlay) gsap.to(overlay, { opacity: 0, duration: 0.6, onComplete: () => overlay.style.display = 'none' });

              // 2. Lock Opacity manually to prevent flashing BEFORE removing the CSS lock
              if (navContainer) {
                navContainer.style.opacity = '0';
                navContainer.style.visibility = 'visible';
              }
              if (targetSvg) {
                targetSvg.style.opacity = '0';
              }

              // Remove Global CSS lock
              document.body.classList.remove('is-preloading');

              // 3. One frame delay to guarantee layout is painted before calculating sizes
              requestAnimationFrame(() => {
                if (sourceSvg && targetSlot) {
                  gsap.set(sourceSvg, { transformOrigin: 'center center' });
                  
                  // Use the target layout SLOT directly for perfect math
                  const sourceRect = sourceSvg.getBoundingClientRect();
                  const targetRect = targetSlot.getBoundingClientRect();

                  // Match aspect ratio exactly to the slot
                  const svgAR = 248 / 140;
                  const slotAR = targetRect.width / targetRect.height;
                  const finalWidth = slotAR > svgAR ? targetRect.height * svgAR : targetRect.width;
                  const scale = finalWidth / sourceRect.width;

                  const deltaX = (targetRect.left + targetRect.width / 2) - (sourceRect.left + sourceRect.width / 2);
                  const deltaY = (targetRect.top + targetRect.height / 2) - (sourceRect.top + sourceRect.height / 2);

                  // Reveal navbar wrapper
                  if (navContainer) gsap.to(navContainer, { opacity: 1, duration: 0.4, delay: 0.1 });

                  // Smooth Swoop Animation (Removed Elastic, Added smooth Expo)
                  gsap.to(sourceSvg, {
                    x: deltaX,
                    y: deltaY,
                    scale: scale,
                    duration: 1.0,
                    ease: 'expo.inOut',
                    onComplete: () => {
                      // Seamless Handover! 
                      // ⚠️ Note: We set opacity directly instead of clearProps: 'all' to protect your clip-path!
                      if (targetSvg) gsap.set(targetSvg, { opacity: 1 });
                      if (navContainer) gsap.set(navContainer, { clearProps: 'visibility' }); 
                      
                      const content = document.getElementById('app-preloader-content');
                      if (content) content.style.display = 'none';
                    }
                  });
                }
              });
            };

            const tickerCallback = () => {
              if (isCompleted) return;

              if (isBrowserLoaded) {
                targetProgress = 100;
              } else if (targetProgress < 90) {
                targetProgress += 0.15;
              }

              currentProgress += (targetProgress - currentProgress) * 0.1;
              const displayPct = Math.min(100, Math.floor(currentProgress));

              const percentText = document.getElementById('app-preloader-percent');
              const bar = document.getElementById('app-preloader-bar');
              if (percentText) percentText.innerText = `${displayPct}%`;
              if (bar) bar.style.width = `${currentProgress}%`;

              const ratio = currentProgress / 100;
              pathData.forEach(({ el, length }) => {
                el.style.strokeDashoffset = `${length * (1 - ratio)}`;
              });

              if (currentProgress > 99.5 && isBrowserLoaded && (Date.now() - startTime > 1200)) {
                isCompleted = true;
                updateLog('[sys] Launching compositor...');
                gsap.ticker.remove(tickerCallback);
                performDocking();
              }
            };

            gsap.ticker.add(tickerCallback);
          };

          document.addEventListener('DOMContentLoaded', runPreloaderAnimation);
          document.addEventListener('astro:page-load', runPreloaderAnimation);
        </script>
      </>
    )}

    <SmoothScroll client:only="react" />
    <Navbar client:load />
    <slot />
  </body>
</html>