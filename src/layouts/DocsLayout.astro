---
import Layout from './Layout.astro';

interface DocItem {
  id: string;
  slug: string;
  title: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  allDocs: DocItem[];
  currentSlug: string;
  headings: Heading[];
}

const { title, description, currentSlug, headings } = Astro.props;

const docNav = [
  { name: 'Overview', slug: '' },
  { name: 'Getting Started', slug: 'getting-started' },
  { name: 'Configuration', slug: 'configuration' },
  { name: 'Keybindings', slug: 'keybindings' },
  { name: 'Physics Engine', slug: 'physics' },
  { name: 'The Interface', slug: 'interface' },
  { name: 'fwmctl & IPC', slug: 'fwmctl' },
  { name: 'Troubleshooting', slug: 'troubleshooting' },
  { name: 'Architecture', slug: 'architecture' },
];
---

<Layout title={`${title} — fwm Docs`} description={description} showPreloader={false}>
  <div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col pt-16">
    <!-- Top Breadcrumb Bar -->
    <header class="border-b border-slate-800/80 bg-slate-950/90 backdrop-blur-md sticky top-16 z-30 px-4 sm:px-8 py-3 flex items-center justify-between text-xs font-mono">
      <div class="flex items-center space-x-2 text-slate-400">
        <a href="/" class="hover:text-amber-400 transition-colors">fwm</a>
        <span>/</span>
        <a href="/docs" class="hover:text-amber-400 transition-colors">docs</a>
        <span>/</span>
        <span class="text-amber-400 font-bold">{currentSlug || 'overview'}</span>
      </div>

      <div class="flex items-center space-x-4">
        <a
          href="https://github.com/iluaii/fwm/tree/main/docs"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-400 hover:text-amber-400 transition-colors flex items-center space-x-1"
        >
          <span>fwm Repo ↗</span>
        </a>
      </div>
    </header>

    <!-- Main Grid -->
    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-8 grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Left Sidebar Navigation -->
      <aside class="md:col-span-3 space-y-6">
        <div class="sticky top-32 space-y-4">
          <div class="fwm-badge px-3 py-1 bg-amber-500/10 font-bold inline-block">
            Documentation
          </div>

          <nav class="flex flex-col space-y-1 font-mono text-xs">
            {docNav.map((item) => {
              const isActive = currentSlug === item.slug;
              return (
                <a
                  href={item.slug ? `/docs/${item.slug}` : '/docs'}
                  class={`px-3 py-2 transition-all flex items-center justify-between border-l-2 ${
                    isActive
                      ? 'border-amber-400 bg-amber-500/10 text-amber-300 font-bold'
                      : 'border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-900/60'
                  }`}
                >
                  <span>{item.name}</span>
                  {isActive && <span class="text-amber-400">•</span>}
                </a>
              );
            })}
          </nav>
        </div>
      </aside>

      <!-- Center Article Content -->
      <main class="md:col-span-6 lg:col-span-7 min-w-0">
        <article class="docs-content max-w-none">
          <slot />
        </article>
      </main>

      <!-- Right Table of Contents -->
      {headings.length > 0 && (
        <aside class="hidden lg:block lg:col-span-2">
          <div class="sticky top-32 space-y-3 font-mono text-xs">
            <span class="text-slate-500 uppercase tracking-widest text-[10px] block font-bold">On This Page</span>
            <nav class="space-y-1.5 border-l border-slate-800 pl-3">
              {headings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class={`block truncate transition-colors text-slate-400 hover:text-amber-300 ${
                    h.depth === 3 ? 'pl-3 text-[11px]' : ''
                  }`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </div>
</Layout>

<script>
  function fixMarkdownLinks() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.docs-content a');
    links.forEach((a) => {
      const href = a.getAttribute('href');
      if (!href) return;

      // Prevent HTTPS security errors by disabling local filesystem (file://) links
      if (href.startsWith('file://')) {
        a.removeAttribute('href');
        a.classList.add('pointer-events-none', 'no-underline');
        return;
      }

      const isRelative =
        !href.startsWith('http://') &&
        !href.startsWith('https://') &&
        !href.startsWith('/');

      if (href.startsWith('../')) {
        const cleanPath = href.replace(/^\.\.\//, '');
        a.href = `https://github.com/iluaii/fwm/blob/main/${cleanPath}`;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      }
      else if (isRelative && (href.endsWith('.md') || href.includes('.md#'))) {
        const [path, hash] = href.split('#');
        let cleanPath = path.replace(/\.md$/, '');

        if (cleanPath === 'README' || cleanPath === 'index') {
          cleanPath = '';
        }

        const newUrl = cleanPath ? `/docs/${cleanPath}` : '/docs';
        a.href = hash ? `${newUrl}#${hash}` : newUrl;
      }
    });
  }

  document.addEventListener('DOMContentLoaded', fixMarkdownLinks);
  document.addEventListener('astro:page-load', fixMarkdownLinks);
  fixMarkdownLinks();
</script>

<style is:global>
  .docs-content {
    color: #cbd5e1;
    font-family: 'Lora', serif;
    font-weight: 300;
    line-height: 1.8;
  }

  .docs-content h1 {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 2.25rem;
    font-weight: 700;
    color: #fbbf24;
    margin-bottom: 1rem;
  }

  .docs-content h2 {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.5rem;
    font-weight: 700;
    color: #f1f5f9;
    border-bottom: 1px solid rgba(51, 65, 85, 0.6);
    padding-bottom: 0.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .docs-content h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 600;
    color: #fbbf24;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .docs-content p {
    margin-bottom: 1.25rem;
  }

  .docs-content a {
    color: #fbbf24;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }

  .docs-content a:hover {
    color: #fde047;
  }

  .docs-content ul, .docs-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }

  .docs-content li {
    margin-bottom: 0.5rem;
  }

  .docs-content code:not(pre code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    background-color: #0f172a;
    color: #fde047;
    padding: 0.2em 0.4em;
    border-radius: 4px;
    border: 1px solid rgba(51, 65, 85, 0.8);
  }

  .docs-content pre {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.825rem;
    background-color: #090d16 !important;
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .docs-content table {
    width: 100%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    border-collapse: collapse;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
  }

  .docs-content th {
    background-color: #0f172a;
    color: #fbbf24;
    text-align: left;
    padding: 0.75rem;
    border-bottom: 1px solid #334155;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .docs-content td {
    padding: 0.75rem;
    border-bottom: 1px solid rgba(51, 65, 85, 0.5);
  }

  .docs-content tr:hover td {
    background-color: rgba(15, 23, 42, 0.5);
  }
</style>